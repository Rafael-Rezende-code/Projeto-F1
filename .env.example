# Variáveis de ambiente da loja. Copie para .env.local (desenvolvimento) e configure as mesmas na Vercel
# (Project → Settings → Environment Variables). NUNCA coloque valores reais neste arquivo: ele vai para o git.
# Sem nenhuma variável, o site funciona como hoje: catálogo do seed local e pagamentos simulados.

# --- Site ---
# URL pública (canonical, Open Graph, sitemap e URL do webhook). Sem barra no fim.
NEXT_PUBLIC_SITE_URL=https://www.sua-loja.com.br

# --- Supabase (fase 9: catálogo e pedidos; fase 11: painel admin) — docs/backend/supabase.md ---
# Project Settings → API. A URL e a chave anon são públicas (o RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: SÓ no servidor (ignora o RLS). Cria pedidos, baixa estoque e recebe o webhook. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel admin (fase 11) — docs/backend/admin.md ---
# E-mails que podem entrar em /admin, separados por vírgula. Cadastre os MESMOS e-mails na tabela admin_emails
# (é ela que o banco usa no RLS para liberar a escrita).
ADMIN_EMAILS=

# --- Mercado Pago (fase 10: Checkout Bricks) — docs/backend/mercadopago.md ---
# Suas integrações → (aplicação) → Credenciais. Use as de TESTE até homologar; depois troque pelas de produção.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Access token: SÓ no servidor.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook: Suas integrações → (aplicação) → Webhooks → Configurar notificações.
MP_WEBHOOK_SECRET=
