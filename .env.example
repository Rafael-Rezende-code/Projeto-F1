# Variáveis de ambiente da loja. Copie para .env.local (desenvolvimento) e configure as mesmas na Vercel
# (Project → Settings → Environment Variables). NUNCA coloque valores reais neste arquivo: ele vai para o git.
# Sem nenhuma variável, o site funciona como hoje: catálogo do seed local e pagamentos simulados.

# --- Site ---
# URL pública (canonical, Open Graph, sitemap e URL do webhook). Sem barra no fim.
NEXT_PUBLIC_SITE_URL=https://www.sua-loja.com.br

# Indexação pelos buscadores: SÓ "true" libera (robots.txt, meta robots, X-Robots-Tag e sitemap). Ausente = site fora do
# índice. Defina "true" apenas em Production, no dia do lançamento, e faça novo deploy (docs/lancamento.md).
NEXT_PUBLIC_ALLOW_INDEXING=

# E-mail de contato exibido no rodapé, em /sobre e em /contato (opcional; sem ele, nada aparece). Os demais dados da
# empresa (razão social, CNPJ/CPF, endereço, telefone) ficam em lib/company.ts.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (fase 9: catálogo e pedidos; fase 11: painel admin) — docs/backend/supabase.md ---
# Project Settings → API Keys. A URL e a chave pública (anon legada ou publishable "sb_publishable_...") são públicas
# (o RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave SECRETA: SÓ no servidor (ignora o RLS). Cria pedidos, baixa estoque e recebe o webhook. Nunca NEXT_PUBLIC_.
# Prefira a secret key nova ("sb_secret_...", revogável) à service_role legada; troca em docs/lancamento.md, seção 1.
# Production e Preview com valores próprios (Vercel); toda mudança exige novo deploy.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel admin (fase 11) — docs/backend/admin.md ---
# E-mails que podem entrar em /admin, separados por vírgula. Cadastre os MESMOS e-mails na tabela admin_emails
# (é ela que o banco usa no RLS para liberar a escrita).
ADMIN_EMAILS=

# --- Mercado Pago (fase 10: Checkout Bricks) — docs/backend/mercadopago.md ---
# Suas integrações → (aplicação) → Credenciais. Use as de TESTE até homologar; depois troque pelas de produção.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Access token: SÓ no servidor.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook: Suas integrações → (aplicação) → Webhooks → Configurar notificações.
MP_WEBHOOK_SECRET=

# --- Frete (refino 2) — docs/backend/frete.md ---
# CEP de origem (de onde a loja posta). Padrão: 37950000 (São Sebastião do Paraíso, MG).
SHIPPING_ORIGIN_CEP=
# Melhor Envio: sem token, o checkout usa o frete simulado. Sandbox até MELHOR_ENVIO_ENV=production.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENV=
MELHOR_ENVIO_CONTACT_EMAIL=
MELHOR_ENVIO_SERVICES=
# Entrega local (faixas de CEP em lib/shipping/config.ts). SÓ EXISTE se ENABLED=true E preço e prazo estiverem preenchidos
# (preço e prazo são promessas: nada é escrito à mão no código). Preço em centavos; prazo em dias úteis.
LOCAL_DELIVERY_ENABLED=
LOCAL_DELIVERY_PRICE_CENTS=
LOCAL_DELIVERY_DAYS_MIN=
LOCAL_DELIVERY_DAYS_MAX=
# Opcional: grátis a partir deste subtotal (centavos). Sem ele, a entrega local nunca é grátis.
LOCAL_DELIVERY_FREE_FROM_CENTS=

# --- Política comercial (lib/store-policy.ts): SEM a variável, o item NÃO aparece no site ---
# Parcelamento anunciado na página do produto ("ou 3x de R$ ... sem juros"): só se as parcelas forem SEM JUROS de verdade.
# O parcelamento real do cartão é o da sua conta do Mercado Pago (o Payment Brick mostra as parcelas reais no checkout).
NEXT_PUBLIC_INSTALLMENTS_MAX=
NEXT_PUBLIC_INSTALLMENTS_INTEREST_FREE=
# Valor mínimo de cada parcela em centavos (opcional).
NEXT_PUBLIC_INSTALLMENT_MIN_CENTS=
# Frete grátis a partir deste subtotal, em centavos (barra na sacola, Econômica grátis, Melhor Envio grátis).
NEXT_PUBLIC_FREE_SHIPPING_FROM_CENTS=
# Frases que a loja se compromete a cumprir (acordeões da página do produto e /sobre). Sem elas, não aparecem.
NEXT_PUBLIC_POLICY_SHIPPING_NOTE=
NEXT_PUBLIC_POLICY_RETURNS_NOTE=
NEXT_PUBLIC_POLICY_WARRANTY_NOTE=
NEXT_PUBLIC_POLICY_DELIVERY_AREA=
# "true" SÓ quando a loja de fato envia e-mails do pedido (hoje não há serviço de e-mail; sem isso, a página do pedido não promete aviso por e-mail).
NEXT_PUBLIC_POLICY_EMAIL_NOTIFICATIONS=
# Prazo MÁXIMO de postagem da pronta entrega, em dias úteis (faixa de benefícios da home). Vazio = o item não aparece.
NEXT_PUBLIC_POLICY_DISPATCH_DAYS_MAX=
# "Restam N unidades" na página do produto quando o estoque da variante for ≤ este número (padrão 5; 0 desliga).
NEXT_PUBLIC_LOW_STOCK_LIMIT=
# Desconto no Pix (loja extra), % inteiro de 1 a 30. Vazio/0 = nada aparece. Incide sobre o subtotal depois de cupom e kit, sem o
# frete; o servidor recalcula pelo meio de pagamento (create_order) e o Pix é criado no Mercado Pago com o valor já descontado.
NEXT_PUBLIC_PIX_DISCOUNT_PERCENT=
# "true" deixa cupom e desconto de kit valerem juntos (padrão: não cumulativos).
NEXT_PUBLIC_COUPON_WITH_KIT=
# Avaliações de produto (refino 3): "true" liga a exibição e o envio pela consulta de pedido (precisa do Supabase). Padrão: desligadas.
NEXT_PUBLIC_REVIEWS_ENABLED=

# --- Redes sociais (lib/social.ts): o ícone só aparece no rodapé se a URL (https) existir ---
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# --- Newsletter (docs/backend/newsletter.md) ---
# Sal para o hash do IP (guardamos só o hash, para o limite por IP). Qualquer texto longo e secreto; só servidor.
NEWSLETTER_IP_SALT=
# Sal do hash do IP no limite de tentativas (checkout, cupom, consulta de pedido, newsletter). Vazio = usa o
# NEWSLETTER_IP_SALT. Texto aleatório longo, só no servidor.
RATE_LIMIT_SALT=

# --- WhatsApp (operação, fase 1a) ---
# Número só com dígitos, com código do país (ex.: 5535999990000). Sem ele, o botão e os links de WhatsApp não aparecem.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Mensagens pré-preenchidas (opcionais; padrão neutro em lib/store-policy.ts). Marcadores: {produto}, {link}, {pedido}.
NEXT_PUBLIC_WHATSAPP_MESSAGE=
NEXT_PUBLIC_WHATSAPP_MESSAGE_PRODUCT=
NEXT_PUBLIC_WHATSAPP_MESSAGE_ORDER=

# --- E-mails do pedido (docs/backend/email.md) ---
# Sem as duas, os e-mails só aparecem no log do servidor (nada é enviado). Só servidor.
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Apex <pedidos@sua-loja.com.br>
EMAIL_FROM=

# --- Medição e marketing (operação, fase 4; lib/analytics.ts) ---
# Sem as duas: nenhum script, nenhum banner. Com alguma: banner de consentimento e o script só depois do "sim".
# A Política de Privacidade precisa citar as ferramentas ligadas (docs/lancamento.md).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
